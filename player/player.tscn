[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://player/player.gd" id="1_script"]
[ext_resource type="PackedScene" uid="uid://buqa37qo6nekt" path="res://Godot/AnimationLibrary_Godot_Standard.glb" id="2_body"]

; Collision shape -- invisible, this is what the physics engine actually
; uses to detect walls/floor/crates. It never gets a material/color.
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.4
height = 1.8

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_script")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CapsuleShape3D_1")

; The old flat gray capsule MeshInstance3D used to go here as a
; placeholder body. It's been replaced by "Body" below -- the
; animated Mannequin character from the animation library, instanced
; as its own mini-scene (it brings its own Skeleton3D and
; AnimationPlayer with it, which player.gd finds and drives -- see
; _update_body_animation() there). The CollisionShape3D above is
; unchanged and still what physics actually uses; Body is purely
; visual and never affects collision.
;
; Position.y = -0.9: the collision capsule above is 1.8m tall,
; centered on the Player's own origin (spans -0.9 to +0.9), so its
; bottom -- the ground -- sits at -0.9. The Mannequin rig's own feet
; sit at ITS origin (y = 0), so moving Body down by 0.9 lines its
; feet up with the capsule's bottom. If the body ever looks like
; it's floating or sinking into the ground once you can see it in
; the editor, nudge this Y value (or add a "scale" property here) to
; match -- rigs can vary slightly in exact height.
[node name="Body" parent="." instance=ExtResource("2_body")]
position = Vector3(0, -0.9, 0)

[node name="Head" type="Node3D" parent="."]
position = Vector3(0, 0.6, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]
current = true
fov = 75.0

; RayCast3D is the player's "interaction sensor" -- a straight invisible
; line pointing wherever the camera looks, out to 3 meters
; (target_position is in the ray's OWN local space, and the camera looks
; down its local -Z axis by default, hence the negative Z).
[node name="InteractRay" type="RayCast3D" parent="Head/Camera3D"]
target_position = Vector3(0, 0, -3)
